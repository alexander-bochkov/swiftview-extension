{
	"manifest_version": 3,
	"name": "SwiftView - Image Viewer",
	"version": "0.1.0",
	"description": "Opens an image in a viewer on the same page when you press and hold it. Supports zoom, pan, rotate and flip.",
	"minimum_chrome_version": "134",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"content_scripts": [
		{
			"js": ["content-script.js"],
			"matches": ["<all_urls>"],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"matches": ["<all_urls>"],
			"resources": ["fonts/*.woff2"],
			"use_dynamic_url": true
		}
	]
}
