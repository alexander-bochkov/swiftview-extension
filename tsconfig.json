{
	"compilerOptions": {
		/* Completeness */
		"skipLibCheck": true,

		/* Emit */
		"noEmit": true,

		/* Interop Constraints */
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,

		/* Language and Environment */
		"jsx": "react-jsx",
		"moduleDetection": "force",

		/* Modules */
		"allowImportingTsExtensions": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"@shared/*": ["./src/shared/*"]
		},
		"types": [
			"chrome",
			"vite-plugin-css-injected-by-js/client",
			"vite-plugin-svgr/client",
			"vite/client"
		],

		/* Type Checking */
		"noUncheckedIndexedAccess": true
	}
}
