{
	"compilerOptions": {
		/* Completeness */
		"skipLibCheck": true,

		/* Emit */
		"noEmit": true,

		/* Interop Constraints */
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,

		/* Language and Environment */
		"jsx": "react-jsx",
		"moduleDetection": "force",

		/* Modules */
		"moduleResolution": "bundler",
		"paths": {
			"@shared/*": ["./src/shared/*"]
		},
		"types": ["chrome", "vite-plugin-svgr/client", "vite/client"],

		/* Type Checking */
		"noUncheckedIndexedAccess": true
	}
}
