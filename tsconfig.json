{
	"compilerOptions": {
		/* Completeness */
		"skipLibCheck": true,

		/* Emit */
		"noEmit": true,

		/* Interop Constraints */
		"isolatedModules": true,

		/* Language and Environment */
		"jsx": "react-jsx",
		"moduleDetection": "force",

		/* Modules */
		"moduleResolution": "bundler",

		/* Type Checking */
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	}
}
